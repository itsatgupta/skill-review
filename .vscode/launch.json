{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: review a skill (CLI)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/cli/review.cjs",
      "args": ["${input:skillPath}", "--fail-on=none"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug: engine tests",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["--test", "${workspaceFolder}/tests/engine.test.cjs"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug: build pages",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/build.cjs",
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {
      "id": "skillPath",
      "type": "promptString",
      "description": "Skill folder to review",
      "default": "skills"
    }
  ]
}
