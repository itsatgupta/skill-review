{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run check:*)",
      "Bash(npm run build:*)",
      "Bash(npm test:*)",
      "Bash(npm run review:*)",
      "Bash(node cli/review.cjs:*)",
      "Bash(node scripts/build.cjs:*)",
      "Bash(node scripts/aggregate-evals.cjs:*)",
      "Bash(node --test:*)"
    ],
    "ask": [
      "Bash(vercel deploy:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.vercel/**)",
      "Bash(npm install:*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/after-edit.cjs\"",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
