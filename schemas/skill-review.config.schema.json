{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Skill Review config",
  "type": "object",
  "properties": {
    "failOn": { "enum": ["blocker", "major", "none"], "description": "CLI exits 1 at or above this severity" },
    "passScore": { "type": "number", "minimum": 0, "maximum": 100 },
    "weights": {
      "type": "object",
      "properties": { "meta": { "type": "number" }, "struct": { "type": "number" }, "content": { "type": "number" }, "pack": { "type": "number" }, "evals": { "type": "number" } },
      "additionalProperties": false
    },
    "allowedHosts": { "type": "array", "items": { "type": "string" }, "description": "Host suffixes allowed in SKILL.md" },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "type", "pattern"],
        "properties": {
          "id": { "type": "string", "pattern": "^T" },
          "title": { "type": "string" },
          "type": { "enum": ["forbid", "require"] },
          "file": { "enum": ["SKILL.md", "description", "any"], "default": "SKILL.md" },
          "pattern": { "type": "string", "description": "JavaScript regex (escape backslashes)" },
          "flags": { "type": "string", "default": "im" },
          "when": { "type": "string", "description": "Regex on the description; rule applies only when it matches" },
          "severity": { "enum": ["blocker", "major", "minor", "info"], "default": "minor" },
          "category": { "enum": ["meta", "struct", "content", "pack", "evals"], "default": "content" },
          "fix": { "type": "string" }
        }
      }
    }
  }
}
