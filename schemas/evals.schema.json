{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Skill evals (skill-creator format)",
  "type": "object",
  "required": ["skill_name", "evals"],
  "properties": {
    "skill_name": { "type": "string" },
    "evals": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "prompt", "expected_output", "assertions"],
        "properties": {
          "id": { "type": ["integer", "string"] },
          "prompt": { "type": "string" },
          "expected_output": { "type": "string" },
          "files": { "type": "array", "items": { "type": "string" } },
          "assertions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "edge_case": { "type": "boolean" }
        }
      }
    },
    "trigger_evals": {
      "type": "array",
      "items": { "type": "object", "required": ["query", "should_trigger"], "properties": { "query": { "type": "string" }, "should_trigger": { "type": "boolean" } } }
    }
  }
}
