# Required for the AI review and evals. Without it the static checks still work.
ANTHROPIC_API_KEY=

# Recommended: a shared team password the page asks for before any AI call.
APP_PASSWORD=

# Optional model overrides (defaults shown)
# MODEL_QUICK=claude-haiku-5-5
# MODEL_DEFAULT=claude-sonnet-5-5
# MODEL_COMPLEX=claude-opus-5-5

# Optional: largest prompt accepted, in characters
# MAX_INPUT_CHARS=400000
